JWT_SECRET_KEY=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Node.js 22.12+ executable; use an absolute path if node is not on PATH.
AI_NODE_BINARY=node
AI_AUTOSTART=1
INDOBERT_MODEL=quarkss/indobert-base-stsb
INDOBERT_THREADS=4
AI_REQUEST_TIMEOUT_SECONDS=30

# Optional: use separately managed services instead of launching children.
# AI_AUTOSTART=0
# AI_CHATBOT_URL=http://127.0.0.1:3001
# AI_SEMANTIC_URL=http://127.0.0.1:3010
# AI_PYTHON_BINARY=/absolute/path/to/model/venv/bin/python
